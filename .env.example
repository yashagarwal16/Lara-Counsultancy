# Public site URL used for canonical metadata and sitemap generation.
# Local: http://localhost:3000
# Production: use the exact public Render URL or custom HTTPS domain.
# Example: https://lara-consultancy.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection.
# Create a database user in MongoDB Atlas, allow your server IP, and copy
# the Driver connection string. Replace <username>, <password>, and <dbname>.
# Example:
# mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Email recipients that receive new enquiries. At least one is required.
CONTACT_RECIPIENT_1=
CONTACT_RECIPIENT_2=
CONTACT_RECIPIENT_3=
CONTACT_RECIPIENT_4=

# SMTP mailbox used to send enquiry notifications.
# For Gmail, use smtp.gmail.com and an App Password, not your normal password.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Dashboard login. Use a long random value for ADMIN_SESSION_SECRET.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Gemini chatbot. Keep this key server-side; never use NEXT_PUBLIC_ here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Twilio WhatsApp. Use plain E.164 numbers; the server adds the whatsapp: prefix.
# Examples: +14155238886 and +12025550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
